# Stage 1: Builder
FROM python:3.11-slim AS builder
WORKDIR /app

# Create a virtual environment so we can easily copy only the installed packages
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements/train.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r train.txt

# Stage 2: Training runtime
FROM python:3.11-slim AS training
WORKDIR /app

# Copy only the virtual environment from the builder stage (avoids carrying over pip cache/build tools)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy source code and default configs
COPY src/ ./src/
COPY configs/ ./configs/

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "src/train.py"]